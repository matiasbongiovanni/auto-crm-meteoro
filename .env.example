# Meteoro CRM — Variables de entorno
# Copiar como .env.local: cp .env.example .env.local

# URL base del sitio (requerido para OAuth redirect)
# Dev: http://localhost:3000 | Prod: https://crm.meteoro.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (requerido)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Meteoro Chat self-hosted (mensajería — sección Mensajería)
# URL pública de la instancia (dev: http://localhost:3000, prod: https://internal.meteoro.com.ar)
NEXT_PUBLIC_METEORO_CHAT_URL=http://localhost:3008
# Platform API token del super admin (server-only, NUNCA con NEXT_PUBLIC_)
CHATWOOT_PLATFORM_TOKEN=<platform-api-token>
# ID del usuario agente que se usa para el SSO (ver seed-instancia.sh para obtenerlo)
CHATWOOT_AGENT_USER_ID=1
# Account ID de la cuenta Meteoro Interno
CHATWOOT_DEFAULT_ACCOUNT_ID=1

# Agentkit (WhatsApp bot)
AGENTKIT_URL=http://localhost:8000
AGENTKIT_ADMIN_TOKEN=<token>

# Usage tracking de Claude (opcional)
# ENABLE_LOCAL_USAGE_INGESTION=true

# Email digest (opcional)
# RESEND_API_KEY=re_...
# DIGEST_EMAIL=tu@email.com

# Claude IA (opcional — clasificación de leads)
# ANTHROPIC_API_KEY=sk-ant-...
